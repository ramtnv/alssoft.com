{
  "name": "alssoft-website",
  "version": "1.0.0",
  "description": "Abacus Logistics Solutions Pvt Ltd - Modernized static website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,js --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,js,html,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,html,scss,css}\""
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.5.0",
    "sass": "^1.85.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0"
  }
}
